# Environment configuration — validated at boot by packages/config (plan/04 §6).
# The process refuses to start on any failure, so names must match EXACTLY.
# Copy to `.env` and fill in. Never commit the filled-in file.

NODE_ENV=development

# --- HTTP server (apps/api) ---
# Bind 127.0.0.1 for local dev; use 0.0.0.0 when the API runs behind a proxy
# or in a container, or it will be unreachable from outside.
API_HOST=127.0.0.1
API_PORT=4000
# Browser origin allowed to call the API (CORS + socket handshake).
DASHBOARD_ORIGIN=http://localhost:3000

# --- Infrastructure (required) ---
# Must start with "mongodb" / "redis" respectively.
MONGO_URI=mongodb://localhost:27017/algotrade
REDIS_URL=redis://localhost:6379

# --- Secrets (required) ---
# Signs/derives operator session ids (plan/21 §4). Minimum 32 characters.
#   generate: openssl rand -base64 48
SESSION_SECRET=
# AES-256-GCM key for broker tokens at rest (plan/24 §5).
# EXACTLY 32 bytes hex-encoded — 64 hex chars, nothing else validates.
#   generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# --- Broker ---
# The composition-root switch (plan/05 §3): Phase 1 = paper, Phase 3 = live.
BROKER_MODE=paper
# Optional in paper mode; all three are REQUIRED when BROKER_MODE=live.
FYERS_APP_ID=
FYERS_APP_SECRET=
FYERS_REDIRECT_URL=

# --- Telemetry ---
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Operator bootstrap (apps/api: pnpm bootstrap:operator) ---
# Read directly by src/bootstrap-operator.ts, not by the config schema.
NEELKANTH_OPERATOR_EMAIL=
# Minimum 12 characters.
NEELKANTH_OPERATOR_PASSWORD=

# --- Dashboard (build-time, inlined into the static export) ---
# Points the browser client at Fastify. Empty string = same origin.
# Nothing secret may go in a NEXT_PUBLIC_* var (plan/06 §8).
NEXT_PUBLIC_API_BASE=http://localhost:4000
