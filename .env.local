# =============================================================================
# Neelkanth Trader — Local Environment Configuration
# =============================================================================

# =========================================
# 🖥️ FRONTEND / UI (Dashboard) Variables
# =========================================
# Variables prefixed with NEXT_PUBLIC_ are baked into the dashboard's static JS
# during the build. Since the dashboard is a static export, it does not read
# server-side variables at runtime.

# The base URL for the backend API.
# In local dev, the API runs on 4000, and the dashboard on 3000.
NEXT_PUBLIC_API_BASE=http://localhost:4000


# =========================================
# ⚙️ BACKEND / API Variables
# =========================================
# These are read ONLY by the Node.js API process (`apps/api`). The frontend
# has no access to these secrets.

NODE_ENV=development

# --- HTTP server ---
API_HOST=127.0.0.1
API_PORT=4000
DASHBOARD_ORIGIN=http://localhost:3000

# --- Infrastructure ---
MONGO_URI=mongodb+srv://mitsonagra123_db_user:ehrg1rx9fqjryEgJ@algo-trade.xoknh0q.mongodb.net/neelkanth_it_scratch
REDIS_URL=rediss://default:gQAAAAAABI3nAAIgcDFhMjU1YjE4MTM4NzE0ZmI2ODVlNTU5NjIxNWMwMjZhMw@good-liger-298471.upstash.io:6379

# --- Secrets ---
SESSION_SECRET=CuPhD2pT3/RFRZRsP29u1B+OXSYyg1DXGDbiIBLvgWT2tVnKi2fikXVuj1zMsj88
TOKEN_ENCRYPTION_KEY=a950fa5ab4d38b8c66e4addad82dfa796facb65b1430983c5ec6da2443b80520

# --- Broker ---
# Set to 'live' when you want to execute real orders via FYERS
BROKER_MODE=paper

# FYERS API app credentials (https://myapi.fyers.in)
FYERS_APP_ID=JH4Z8OPATX-100
FYERS_APP_SECRET=ETKVNA68OFL
FYERS_REDIRECT_URL=http://localhost:3000/api/broker/fyers/callback

# --- Telemetry ---
LOG_LEVEL=info

# --- Operator bootstrap ---
NEELKANTH_OPERATOR_EMAIL=mitesh.sonagra.dev@gmail.com
NEELKANTH_OPERATOR_PASSWORD=mitesh@5576
