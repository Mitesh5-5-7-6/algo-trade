# Credentials for `pnpm test:integration`. Copy to `.env.test.local`, which is
# gitignored by the `.env.*` rule and read by scripts/test-integration.mjs only.
#
# These must be SCRATCH instances. Never the deployed ones:
#
#   - Every Mongo integration suite calls dropDatabase(). The runner refuses
#     any database not named neelkanth_it_* / neelkanth_ci_*, but that guard
#     protects the database, not the cluster — point it at a fresh one.
#   - The Redis suites never flush, but they DO write real keys, including
#     `risk:dailyLoss:<date>` — the live daily-loss counter. Running against a
#     production Redis would overwrite today's real figure with a test value.
#
# An explicit shell variable wins over anything set here.

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/neelkanth_it_scratch?retryWrites=true&w=majority
REDIS_URL=rediss://<user>:<password>@<host>:<port>
