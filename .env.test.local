# Written by Claude from .env.local. Gitignored; read only by
# scripts/test-integration.mjs.
#
# MONGO_URI points at the scratch database neelkanth_it_scratch. The suites
# drop it on every run, which is why the runner refuses any other name.
# Standard (non-SRV) form. This sandbox refuses DNS SRV lookups, so
# mongodb+srv:// fails with querySrv ECONNREFUSED; the shard hosts and
# replicaSet below were resolved over DNS-over-HTTPS and are equivalent.
MONGO_URI=mongodb://mitsonagra123_db_user:ehrg1rx9fqjryEgJ@ac-unb5lwb-shard-00-00.xoknh0q.mongodb.net:27017,ac-unb5lwb-shard-00-01.xoknh0q.mongodb.net:27017,ac-unb5lwb-shard-00-02.xoknh0q.mongodb.net:27017/neelkanth_it_scratch?ssl=true&replicaSet=atlas-tx7obh-shard-0&authSource=admin
#
# A SECOND Upstash database, separate from the deployed one. The suites write
# real keys including risk:dailyLoss:<date> — the live daily-loss counter — so
# they must never point at the instance production uses.
REDIS_URL=rediss://default:gQAAAAAABIvnAAIgcDI3ODdiMjY2OTdkN2I0ODk5ODAzNWM1M2IyZjMxNzAzZQ@rested-mole-297959.upstash.io:6379
