# The AI research agent's own environment (Phase 11, design D5).
#
# Copy to .env.agent.local (gitignored) and fill in. Hold ONLY these two:
# the agent refuses to start if any broker or production secret — FYERS_*,
# TOKEN_ENCRYPTION_KEY, SESSION_SECRET, NEELKANTH_OPERATOR_*, REDIS_URL,
# BROKER_MODE — is in its environment (ARCHITECTURE_DECISION §13.3).
#
#   cd apps/api && node --env-file=../../.env.agent.local scripts/agent.mts ask "…"

# Anthropic API key for Claude Opus 5.5 (design Q1).
ANTHROPIC_API_KEY=

# The research database's cluster. The agent reads neelkanth_research (or a
# scratch neelkanth_it_* / neelkanth_ci_* database) and writes agent_answers.
MONGO_URI=
