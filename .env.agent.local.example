# The AI research agent's own environment (Phase 11, design D5, D8).
#
# DO NOT put real values in this file — it is committed to git.
# Copy it to .env.agent.local (gitignored) and fill in the copy.
#
# Hold ONLY these: the agent refuses to start if any broker or production
# secret — FYERS_*, TOKEN_ENCRYPTION_KEY, SESSION_SECRET, NEELKANTH_OPERATOR_*,
# REDIS_URL, BROKER_MODE — is in its environment (ARCHITECTURE_DECISION §13.3).
#
#   cd apps/api && node --env-file=../../.env.agent.local scripts/agent.mts ask "…"

# Which provider answers: anthropic (default), openai or deepseek.
AGENT_PROVIDER=

# The model, by the provider's own name for it. Required for openai and
# deepseek; for anthropic, empty means Claude Opus 5.5 (claude-opus-5-5).
AGENT_MODEL=

# The key of the chosen provider — only that one is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# The research database's cluster. The agent reads neelkanth_research (or a
# scratch neelkanth_it_* / neelkanth_ci_* database) and writes agent_answers.
MONGO_URI=
